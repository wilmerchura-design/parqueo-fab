# Copiar a .env y completar
SECRET_KEY=cambia-esta-clave
# MySQL: crear antes la base:  CREATE DATABASE parqueo CHARACTER SET utf8mb4;
DATABASE_URI=mysql+pymysql://root:tu_password@localhost:3306/parqueo
# API gratuita de Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
